# Use "db" inside docker compose, "localhost" when running the API outside Docker.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
# Replace before use.
DB_PASSWORD=change-me
DB_NAME=task_manager
# PostgreSQL sslmode. Defaults to "disable" when unset.
# DB_SSLMODE=disable

# Optional. When set, it replaces the DB_* variables for migrations.
# DATABASE_URL=

# Required, at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me
APP_PORT=8080

# Docker image: file:///app/database/migrations (set in the Dockerfile).
# Local run: leave unset, the default is file://database/migrations (relative to the working directory).
# MIGRATIONS_PATH=file://database/migrations
